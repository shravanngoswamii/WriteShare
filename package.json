{
  "name": "writeshare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Serverless Markdown writing desk for GitHub-backed blogs. Writes to your repo through draft branches and PRs — no server, no database.",
  "author": "Shravan Goswami",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@milkdown/crepe": "^7.6.4",
    "katex": "^0.16.11",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vue-tsc": "^3.2.9"
  }
}
